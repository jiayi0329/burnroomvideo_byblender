# Default deny: application/diagnostic Python source, synthetic tests and dependencies only.
**
!Dockerfile
!.dockerignore
!requirements.txt
!app/
!app/**
!test/
!test/**
!tools/
!tools/__init__.py
!tools/diagnostics/
!tools/diagnostics/*.py
# Re-exclude secrets/caches even if accidentally placed inside allowed directories.
**/.env
**/.env.*
**/prod.env
**/*secret*
**/__pycache__/
**/*.pyc
**/*.pem
**/*.key
