# Auto detect text files and perform LF normalization
* text=auto
# Remote Bash scripts must remain runnable after a Windows checkout.
*.sh text eol=lf
# Applied SQL migrations use immutable byte fingerprints across checkouts.
*.sql text eol=lf
# Preserve the exact bytes approved for each historical render preset.
configs/render/room_fire_round1.json text eol=lf
configs/render/room_fire_round2.json text eol=crlf
configs/render/room_fire_round3.json text eol=crlf
