# Default deny: application/engine/diagnostic source, named presets and synthetic tests.
**
!Dockerfile
!.dockerignore
!requirements.txt
!backend/
!backend/**/
!backend/**/*.py
!backend/database/migrations/001_rooms.sql
backend/**/*.json
backend/**/*.blend
backend/**/*.glb
backend/**/*.png
backend/**/*.jpg
backend/**/*.mp4
!render_engine/
!render_engine/**/
!render_engine/**/*.py
!configs/
!configs/render/
!configs/render/room_fire_round1.json
!configs/render/room_fire_round2.json
!configs/render/room_fire_round3.json
render_engine/**/*.json
render_engine/**/*.blend
render_engine/**/*.glb
render_engine/**/*.png
render_engine/**/*.jpg
render_engine/**/*.mp4
!tests/
!tests/**/
!tests/**/*.py
!tools/
!tools/__init__.py
!tools/diagnostics/
!tools/diagnostics/*.py
!tools/diagnostics/blender/
!tools/diagnostics/blender/*.py
# Re-exclude secrets/caches even if accidentally placed inside allowed directories.
**/.env
**/.env.*
**/prod.env
**/*secret*
**/__pycache__/
**/*.pyc
**/*.pem
**/*.key
