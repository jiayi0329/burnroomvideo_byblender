# 生产环境配置模板 (部署时请复制为 prod.env 并填写真实密码)
MINIO_ROOT_USER=admin_blender
MINIO_ROOT_PASSWORD=YOUR_STRONG_PASSWORD_HERE

# 追加到远端 prod.env；不要覆盖现有 MinIO 密码或 DK_APPKEY。
PGHOST=postgres
PGPORT=5432
PGDATABASE=burnroom
PGUSER=burnroom_app
PGPASSWORD=REPLACE_WITH_A_NEW_STRONG_DATABASE_PASSWORD
# 仅 postgres 容器使用的初始化管理员密码
POSTGRES_PASSWORD=REPLACE_WITH_A_DIFFERENT_ADMIN_PASSWORD
